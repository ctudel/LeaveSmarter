{
  "builds": [
    {
      "src": "src/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "src/css/*",
      "use": "@vercel/static"
    },
    {
      "src": "src/js/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/$1"
    }
  ]
}
